<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/default_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:layout_width="259dp"
            android:layout_height="37dp"
            android:layout_marginBottom="32dp"
            android:text="Choose the difficulty"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spelling_basic"
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_default"
            android:text="Basic"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spelling_enhanced"
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_default"
            android:text="Enhanced"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spelling_elite"
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_default"
            android:text="Elite"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_customize"
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:background="@drawable/button_default"
            android:text="Customize"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="50dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_mute"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@android:drawable/ic_lock_silent_mode_off"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:backgroundTint="@android:color/transparent"
        app:iconTint="@android:color/black"
        app:elevation="0dp" />

</RelativeLayout>